{
  "manifest_version": 3,
  "name": "LanDeck 域名记录",
  "version": "1.0.0",
  "description": "把浏览器激活标签的域名推送给 LanDeck Agent，用于活动统计的网站域分类（本机 localhost 通信，不上传外部服务）。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8420/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
