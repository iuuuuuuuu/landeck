agent/dist/
app/src-tauri/target/
app/dist/
bin/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.apk
*.aab

# runtime state (per-machine, never commit)
data/
*.log
*.pid

# local env
.env
.env.local
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# notes board artifacts
.agents/notes/board.html
.agents/notes/demo.html

# local QA artifacts
.tmp/

# Android 工程：只提交工程配置，不提交构建产物与签名材料
app/src-tauri/gen/android/.gradle/
app/src-tauri/gen/android/build/
app/src-tauri/gen/android/app/build/
app/src-tauri/gen/android/app/src/main/assets/
app/src-tauri/gen/android/local.properties
app/src-tauri/gen/android/*.keystore
app/src-tauri/gen/android/keystore.properties
app/src-tauri/gen/android/.idea/

